[Unit]
Description=BrewNode Frontend Web Server
After=network.target

[Service]
Type=simple
User=dave
WorkingDirectory=/home/dave/git/brewnode-frontend
ExecStart=/usr/bin/npx http-server dist -p 80 --cors
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=brewnode-frontend

# Environment
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
